{
  "name": "kqlstore",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted KQL query manager for Microsoft Sentinel and Defender XDR",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:js": "esbuild src/main.jsx --bundle --minify --format=esm --target=es2020 --jsx=automatic --outfile=dist/app.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/app.css -o dist/app.css --minify",
    "dev": "npm run build && node scripts/serve.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "lucide-react": "0.454.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@vitest/coverage-v8": "2.1.9",
    "axe-core": "4.12.1",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "tailwindcss": "3.4.17",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
