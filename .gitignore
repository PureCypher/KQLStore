# Build output — dist/ is produced by esbuild + the Tailwind CLI at image build
# time (see Dockerfile) and must never be committed.
dist/

# Dependencies
node_modules/

# The AI service's copy of the shared redaction module. The Dockerfile copies
# api/lib/redact.js into the image; locally it is a symlink so there is exactly
# one source of truth rather than a file that can drift (see api-ai/Dockerfile).
api-ai/lib/redact.js

# Local data
*.db
*.db-wal
*.db-shm
data/

# Tooling scratch — .playwright-mcp was committed once already and had to be
# deleted in e0670a3; keep it out for good.
.playwright-mcp/
*.log

# Editor / OS
.DS_Store
.idea/
.vscode/
coverage/
