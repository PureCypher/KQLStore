# ---------------------------------------------------------------------------
# Editor defaults. These describe what the codebase already does — they are not a
# proposal to change it. Verified against api/ and src/ before being written down.
# ---------------------------------------------------------------------------
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# YAML forbids tabs outright, so the indent settings above are load-bearing here
# rather than cosmetic: a tab in a k8s manifest is a parse error, not a style nit.
[*.{yml,yaml}]
indent_size = 2

[*.{js,jsx,cjs,mjs,json}]
indent_size = 2

# Two trailing spaces are a hard line break in Markdown. Stripping them silently
# reflows the paragraph, so leave them alone in prose.
[*.md]
trim_trailing_whitespace = false

# The nginx config and Dockerfiles are read far more often than they are edited;
# keep them consistent with everything else.
[{Dockerfile,*.conf}]
indent_size = 2

[Makefile]
indent_style = tab
